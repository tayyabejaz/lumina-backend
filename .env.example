APP_ENV=development
# PORT is provided by Railway in production; only set it locally.
PORT=8000
# Number of Uvicorn worker processes (keep low on small instances).
WEB_CONCURRENCY=2
# CORS: comma-separated allowed origins (e.g. https://your-app.vercel.app). "*" allows all (bring-up only).
CORS_ALLOW_ORIGINS=*

# Supabase (DB + Auth + Storage)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Connect through Supabase pooler (Supavisor) in transaction mode for high concurrency.
# asyncpg URL via the pooler host (port 6543), NOT the direct 5432 connection.
DATABASE_URL=postgresql+asyncpg://postgres:<pwd>@<project>.pooler.supabase.com:6543/postgres
DATABASE_REPLICA_URL=postgresql+asyncpg://postgres:<pwd>@<project>-ro.pooler.supabase.com:6543/postgres

REDIS_URL=redis://localhost:6379
QUEUE_REDIS_URL=redis://localhost:6379/1

LLM_API_BASE_URL=
LLM_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
